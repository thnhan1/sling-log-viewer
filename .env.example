# Optional default log directory (absolute path). Used when the app has no saved folder yet.
# Copy this file to .env and edit. The app also remembers the last folder you set in the UI (localStorage).
LOG_ROOT=

# Optional server port (default: 3333)
PORT=3333

# ── Remote AEM UAT (optional) ──
# AEM_UAT_URL=https://aem-uat.example.com
# AEM_UAT_USER=your-username
# AEM_UAT_PASS=your-password
# AEM_LOG_FILES=error.log,request.log,stdout.log
